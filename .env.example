# AI API configuration (OpenAI-compatible)
# Works with DeepSeek / Zhipu GLM / Moonshot / Qwen / OpenAI etc.
# Get a DeepSeek key (cheapest, ~1 RMB per million tokens): https://platform.deepseek.com
AI_API_KEY=sk-your-key-here
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
# Set AI_MOCK=1 to test without network (returns a canned response)
# AI_MOCK=1
